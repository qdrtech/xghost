#
# The supporting bundles: the weaker controls.
#
# The two tests below record what GTK does: how it resolves a relative import
# when the path it was given holds a symbolic link, and what it keeps when that
# import fails. No change to this project can make GTK do either of those
# differently, so no mutation of the sources can break them, and the controls
# mutate the assertion instead. That proves the assertion runs and is compared.
# It does not prove the test is sensitive to this project, because it is not:
# it is a record of GTK.
#

m_flip_the_gtk_resolution_assertion() {
	substitute "$SUITE" '	[[ $output != *DECOY* ]]' '	[[ $output == *DECOY* ]]'
}

m_flip_the_dofile_assertion() {
	substitute tests/nvim.bats '	[ ! -f "$out" ]
}

@test "'"'"'require'"'"' of a missing palette would stop the rest of init.lua" {' \
		'	[ -f "$out" ]
}

@test "'"'"'require'"'"' of a missing palette would stop the rest of init.lua" {'
}

m_flip_the_dotdot_assertion() {
	substitute tests/nvim.bats '	[ "${lines[0]}" = "dotdot=false" ]' '	[ "${lines[0]}" = "dotdot=true" ]'
}

m_flip_the_null_error_assertion() {
	substitute "$SUITE" '	[ "$first" = "return 1" ] || {' \
		'	[ "$first" = "return 0" ] || {'
}

