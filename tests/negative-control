#
# The path to the bridge. This bundle is the one that may not write a '..', and
# a careless commit would put the form of every other bundle back.
#

m_the_loader_writes_the_relative_include_of_every_other_bundle() {
	substitute "$NVIM_LOADER" \
		'M.RELATIVE_PATH = "xghost-generated/nvim/colors.lua"' \
		'M.RELATIVE_PATH = "../xghost-generated/nvim/colors.lua"'
	substitute "$NVIM_LOADER" \
		'	local parent = vim.fn.fnamemodify(vim.fn.stdpath("config"), ":h")' \
		'	local parent = vim.fn.stdpath("config")'
}

m_the_loader_names_the_state_directory() {
	substitute "$NVIM_LOADER" \
		'	local parent = vim.fn.fnamemodify(vim.fn.stdpath("config"), ":h")
	return parent .. "/" .. M.RELATIVE_PATH' \
		'	local parent = vim.fn.expand("~/.local/state/xghost/generated")
	return parent .. "/nvim/colors.lua"'
}

#
# The loader. 'loadfile' is what keeps a missing palette from stopping
# init.lua, and the report is what keeps it from being silent.
#

m_the_loader_uses_dofile() {
	substitute "$NVIM_LOADER" \
		'	local chunk, message = loadfile(path)
	if not chunk then
		return nil, message
	end

	local ok, palette = pcall(chunk)
	if not ok then
		return nil, tostring(palette)
	end' \
		'	local palette = dofile(path)'
}

m_the_loss_is_never_reported() {
	substitute "$NVIM_LOADER" \
		'	local line = "xghost: " .. problem
	vim.schedule(function()
		vim.api.nvim_echo({ { line, "WarningMsg" } }, true, {})
	end)' \
		'	local _ = problem'
}

m_the_report_leaves_the_message_history() {
	substitute "$NVIM_LOADER" \
		'		vim.api.nvim_echo({ { line, "WarningMsg" } }, true, {})' \
		'		io.stderr:write(line .. "\n")'
}

m_the_report_goes_back_through_vim_notify() {
	substitute "$NVIM_LOADER" \
		'		vim.api.nvim_echo({ { line, "WarningMsg" } }, true, {})' \
		'		vim.notify(line, vim.log.levels.WARN)'
